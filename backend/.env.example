FACTOS_DATA_DIR=./data
FACTOS_ALLOWED_ORIGIN=http://localhost:5173
FACTOS_LOCALHOST_DEVELOPMENT=true

# Set concrete model IDs selected for your build. No model-picker API.
FACTOS_GEMINI_API_KEY=
FACTOS_GEMINI_MODEL=
FACTOS_OPENAI_API_KEY=
FACTOS_EMBEDDING_MODEL=
FACTOS_EMBEDDING_DIMENSION=1536
FACTOS_EMBEDDING_MAX_TOKENS=8191

# Firecrawl is the only website crawler. No site fetching by other providers.
FACTOS_FIRECRAWL_API_KEY=
FACTOS_FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# Enable only after confirming the configured Firecrawl deployment blocks private
# destinations, DNS rebinding and unsafe redirects at the actual fetch boundary.
FACTOS_FIRECRAWL_PUBLIC_FETCH_ENFORCED=false
